{
  "name": "musinsa-review-monitor",
  "version": "1.0.0",
  "description": "무신사 포토후기 TOP10 순위 변동 모니터링 및 텔레그램 알림 웹앱",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "check": "tsx src/scripts/runCheck.ts",
    "check:build": "node dist/scripts/runCheck.js",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
