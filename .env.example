# Neon(또는 다른 Postgres) 커넥션 스트링
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# 텔레그램 봇 (BotFather로 생성, README.md 참고)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 대시보드 로그인 비밀번호 (직접 정하세요)
DASHBOARD_PASSWORD=
# 세션 쿠키 서명용 임의의 긴 문자열 (직접 정하세요)
SESSION_SECRET=

# Express 포트 (Render가 자동으로 PORT를 주입하므로 로컬 개발용 기본값)
PORT=3000
